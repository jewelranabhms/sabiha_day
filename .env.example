# ─────────────────────────────────────────────────────────────
# SABIHA SYSTEM — environment
# Copy to .env and fill in. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Data source: "local" (file-backed JSON store, great for demo/dev)
#              "supabase" (production)
DATA_SOURCE=local

# ── Supabase (production) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin dashboard ──────────────────────────────────────────
# Password for /admin — change this before going live.
ADMIN_PASSWORD=change-me-before-launch
# Secret used to sign session cookies (long random string)
SESSION_SECRET=please-change-me-to-a-long-random-string

# ── Sabiha's Day app (private area) ──────────────────────────
# Optional: restrict the private app to a single email login.
SABIHA_EMAIL=
SABIHA_DEFAULT_PIN=

# ── Site content ─────────────────────────────────────────────
# Where the JSON store keeps its data (relative to website/)
LOCAL_DATA_FILE=data/db.json
